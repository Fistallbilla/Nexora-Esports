rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && request.auth.uid == get(/databases/$(db)/documents/settings/main).data.adminUid; }
    function host(t) { return get(/databases/$(db)/documents/tournaments/$(t)).data.by == request.auth.uid; }

    match /settings/{d} {
      allow read: if true;
      allow write: if admin();
    }
    match /tournaments/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.by == request.auth.uid;
      allow update, delete: if signed() && (resource.data.by == request.auth.uid || admin());
    }
    match /entries/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.u == request.auth.uid
        && id == request.resource.data.t + '_' + request.auth.uid
        && (request.resource.data.paid == false
            || get(/databases/$(db)/documents/tournaments/$(request.resource.data.t)).data.fee == 0);
      allow update: if signed() && (admin() || host(resource.data.t)
        || (resource.data.u == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ref'])));
      allow delete: if signed() && (resource.data.u == request.auth.uid || admin() || host(resource.data.t));
    }
  }
}
